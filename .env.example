# ConcursFoco — variáveis de ambiente (template)
# Copie para .env e preencha com valores locais. NUNCA versionar .env (ver .gitignore).
# Porta host do Postgres: 5433 (5432 está ocupada por outro projeto local — ver docker-compose.yml).

# --- Banco de dados (PostgreSQL via Docker — ver docker-compose.yml) ---
DATABASE_URL="postgresql://concursfoco:concursfoco@localhost:5433/concursfoco?schema=public"

# --- Banco de TESTE isolado para a suíte de integração PostgreSQL real (S6.1) ---
# OBRIGATÓRIA para `npm run test:pg`. NUNCA aponte para o banco de aplicação
# (concursfoco) nem para produção. O nome do banco DEVE casar
# ^[A-Za-z0-9_]+_test$ (ex.: concursfoco_test); a suíte recusa executar caso
# contrário (valida esquema postgresql:/postgres: e o nome antes de qualquer
# conexão/SQL). NÃO há derivação a partir de DATABASE_URL — se ausente/vazia,
# a suíte lança erro e não roda. Sem valor/secreto neste template — preencha
# localmente com o banco de teste isolado.
# TEST_DATABASE_URL="postgresql://concursfoco:concursfoco@localhost:5433/concursfoco_test?schema=public"

# --- Autenticação (Auth.js v5) ---
# Gere com: npm exec auth secret   (ou: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# --- Serviços externos (comentados — preencher nos slices correspondentes) ---
# R2 (Cloudflare) — armazenamento de arquivos
# S2 - preencher no slice S2
# STORAGE_DRIVER="stub"  # "stub" (default sem credenciais, dev/CI) | "r2" (requer R2_* abaixo)
# R2_BUCKET=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"  # ou R2_ACCOUNT_ID para derivar

# Bunny Stream — transcodificação, upload TUS e callback de vídeo (S5)
# BUNNY_API_KEY=""
# BUNNY_LIBRARY_ID=""
# Chave separada para Embed View Token Authentication (não reutilize BUNNY_API_KEY).
BUNNY_TOKEN_SECURITY_KEY=""
# Chave read-only usada pelo Bunny para assinar callbacks (não é a API key).
BUNNY_WEBHOOK_SECRET=""

# Mercado Pago — pagamentos (cartão e Pix)
# S6 - preencher no slice S6
# MP_ACCESS_TOKEN=""
# MP_WEBHOOK_SECRET=""
